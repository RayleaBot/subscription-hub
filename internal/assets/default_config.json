{
  "enabled": true,
  "delivery_max_age_minutes": 30,
  "account_check_interval_minutes": 360,
  "account_browser_mode": "auto",
  "account_browser_remote_debugging_url": "",
  "subscriptions": [],
  "resolver": {
    "targets": [],
    "super_admin_whitelist": false,
    "cooldowns": {
      "same_link_enabled": true,
      "same_link_seconds": 10,
      "same_platform_enabled": false,
